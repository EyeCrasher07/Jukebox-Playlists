// Optional LazoDiscs scenario, inserted into the independent ClientChecks class.
private static void lazoScenario() throws Exception {
    server(() -> {
        var player = mc.getSingleplayerServer().getPlayerList().getPlayers().get(0);
        mc.getSingleplayerServer().getPlayerList().op(player.getGameProfile());
        return null;
    });
    ItemStack a = burn("a", "Playlist Lazo A");
    ItemStack b = burn("b", "Playlist Lazo B");
    Object dataA = discData(a), dataB = discData(b);
    server(() -> {
        chest().setItem(0, new ItemStack(Items.STONE));
        chest().setItem(3, a.copy());
        chest().setItem(7, b.copy());
        chest().setChanged();
        return null;
    });
    await(() -> onClient(() -> lazoActive("Playlist Lazo A") && activeCount() == 0), 60000,
        "burned Lazo A reaches Plasmo Voice with positive volume and no native record audio");
    check(server(() -> dataA.equals(discData(box().playlist$current()))), "installed mod starts the actual burned disc A");
    client(() -> { mc.gui.setOverlayMessage(net.minecraft.network.chat.Component.literal("LazoDiscs: Playlist Lazo A (440 Hz)"), false); return null; });
    shot("00-lazodiscs-a");
    await(() -> onClient(() -> lazoActive("Playlist Lazo B") && activeCount() == 0), 45000,
        "real completion switches to burned Lazo B through Plasmo Voice");
    check(server(() -> dataB.equals(discData(box().playlist$current())) && dataA.equals(discData(chest().getItem(7))) && chest().getItem(0).getItem() == Items.STONE),
        "natural custom transition preserves both complete recordings and stone");
    client(() -> { mc.gui.setOverlayMessage(net.minecraft.network.chat.Component.literal("LazoDiscs: Playlist Lazo B (880 Hz)"), false); return null; });
    shot("00-lazodiscs-b");
    server(() -> {
        mc.getSingleplayerServer().overworld().setBlock(POS, Blocks.AIR.defaultBlockState(), 3);
        for (int i = 0; i < chest().getContainerSize(); i++) chest().setItem(i, ItemStack.EMPTY);
        mc.getSingleplayerServer().overworld().setBlock(POS, Blocks.JUKEBOX.defaultBlockState(), 3);
        return null;
    });
    await(() -> onClient(() -> !lazoActive("Playlist Lazo B")), 10000, "removal stops the custom client source before native regression");
}

private static ItemStack burn(String file, String title) throws Exception {
    server(() -> {
        var player = mc.getSingleplayerServer().getPlayerList().getPlayers().get(0);
        player.setItemInHand(InteractionHand.MAIN_HAND, new ItemStack(Items.MUSIC_DISC_11));
        mc.getSingleplayerServer().getCommands().performPrefixedCommand(player.createCommandSourceStack().withPermission(4),
            "lazodisc burn " + System.getProperty("playlist.audioBase") + "/" + file + ".wav " + title);
        return null;
    });
    await(() -> {
        try { return server(() -> {
            Object data = discData(mc.getSingleplayerServer().getPlayerList().getPlayers().get(0).getMainHandItem());
            return data != null && title.equals(data.getClass().getMethod("title").invoke(data));
        }); } catch (Exception failure) { throw new RuntimeException(failure); }
    }, 60000, "official /lazodisc burn creates " + title);
    return server(() -> {
        var player = mc.getSingleplayerServer().getPlayerList().getPlayers().get(0);
        ItemStack copy = player.getMainHandItem().copy();
        player.setItemInHand(InteractionHand.MAIN_HAND, ItemStack.EMPTY);
        return copy;
    });
}

private static Object discData(ItemStack stack) throws Exception {
    return ((java.util.Optional<?>) Class.forName("com.eyecrasher.lazodiscs.data.DiscDataUtil")
        .getMethod("read", ItemStack.class).invoke(null, stack)).orElse(null);
}

private static boolean lazoActive(String track) throws Exception {
    Object voice = Class.forName("su.plo.voice.client.ModVoiceClient").getField("INSTANCE").get(null);
    Object manager = voice.getClass().getMethod("getSourceManager").invoke(voice);
    var sources = (java.util.Collection<?>) manager.getClass().getMethod("getSources").invoke(manager);
    Class<?> api = Class.forName("su.plo.voice.api.client.audio.source.ClientAudioSource");
    var infoMethod = Class.forName("su.plo.voice.api.audio.source.AudioSource").getMethod("getSourceInfo");
    int playing = 0;
    boolean found = false;
    for (Object source : sources) {
        if (!(Boolean) api.getMethod("isActivated").invoke(source)) continue;
        if (((Number) api.getMethod("getEffectiveVolume").invoke(source)).floatValue() <= 0) continue;
        Object info = infoMethod.invoke(source);
        if (!"lazodiscs".equals(info.getClass().getMethod("getAddonId").invoke(info))) continue;
        playing++;
        found |= track.equals(info.getClass().getMethod("getName").invoke(info));
    }
    return found && playing == 1;
}
