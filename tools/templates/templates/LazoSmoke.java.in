package dev.eyecrasher.jukeboxplaylists;

import java.lang.reflect.*;
import java.util.Map;
import java.util.Optional;
import java.util.UUID;
import net.minecraft.core.BlockPos;
import net.minecraft.server.MinecraftServer;
import net.minecraft.world.Container;
import net.minecraft.world.item.ItemStack;
import net.minecraft.world.item.Items;
import net.minecraft.world.level.Level;
import net.minecraft.world.level.block.Blocks;
import net.minecraft.world.level.block.entity.JukeboxBlockEntity;

/** Uses the real published LazoDiscs manager, decoder and Plasmo Voice server. */
public final class LazoSmoke {
    private static final BlockPos POS = new BlockPos(0, 100, 0);
    private static Level world;
    private static PlaylistJukebox box;
    private static Container chest;
    private static Object manager, discA, discB, previousSource;
    private static Method read, write, finish;
    private static Field active;
    private static int ticks, phase, since, checks;
    private static boolean done;

    public static void tick(MinecraftServer server) {
        if (done) return;
        try {
            if (++ticks > 3600) throw new AssertionError("LazoDiscs integration timed out at phase " + phase);
            if (phase == 0) {
                Class<?> bridge = Class.forName("com.eyecrasher.lazodiscs.voice.PlasmoVoiceBridge");
                if (!(Boolean) bridge.getMethod("isInitialized").invoke(bridge.getField("INSTANCE").get(null))) return;
                world = server.overworld();
                server.overworld().setChunkForced(0, 0, true);
                world.setBlock(POS, Blocks.JUKEBOX.defaultBlockState(), 3);
                world.setBlock(POS.above(), Blocks.CHEST.defaultBlockState(), 3);
                box = (PlaylistJukebox) world.getBlockEntity(POS);
                chest = (Container) world.getBlockEntity(POS.above());
                manager = Class.forName("com.eyecrasher.lazodiscs.LazoDiscs").getMethod("playback").invoke(null);
                active = manager.getClass().getDeclaredField("active");
                active.setAccessible(true);
                for (Method method : manager.getClass().getDeclaredMethods()) if (method.getName().equals("finishAt")) finish = method;
                finish.setAccessible(true);
                Class<?> data = Class.forName("com.eyecrasher.lazodiscs.data.CustomDiscData");
                Constructor<?> constructor = data.getConstructor(String.class, String.class, int.class, float.class, UUID.class);
                String base = System.getProperty("playlist.audioBase");
                discA = constructor.newInstance(base + "/a.wav", "Playlist Lazo A", 32, 1.0F, UUID.fromString("00000000-0000-4000-8000-000000000001"));
                discB = constructor.newInstance(base + "/b.wav", "Playlist Lazo B", 32, .7F, UUID.fromString("00000000-0000-4000-8000-000000000002"));
                Class<?> util = Class.forName("com.eyecrasher.lazodiscs.data.DiscDataUtil");
                read = util.getMethod("read", ItemStack.class);
                write = util.getMethod("write", ItemStack.class, data);
                chest.setItem(0, new ItemStack(Items.STONE));
                chest.setItem(3, record(discA));
                chest.setItem(7, record(discB));
                chest.setChanged();
                next();
            } else if (phase == 1 && source() != null) {
                check(custom(box.playlist$current()).equals(discA), "chest autostarts the complete custom disc A");
                check(chest.getItem(3).isEmpty() && chest.getItem(0).getItem() == Items.STONE, "autostart preserves slots and stone");
                previousSource = source();
                for (int i = 0; i < 10000; i++) box.playlist$tick();
                check(source() == previousSource && custom(box.playlist$current()).equals(discA), "vanilla timer cannot truncate a LazoDiscs recording");
                check(sourceCount() == 1, "exactly one Plasmo playback source is active");
                next();
            } else if (phase == 2 && ticks - since > 160 && custom(box.playlist$current()).equals(discB)) {
                check(source() != null && source() != previousSource, "real audio completion starts the next LazoDiscs source");
                check(custom(chest.getItem(7)).equals(discA), "exchange preserves custom URL, title, UUID, range and volume");
                previousSource = source();
                eject();
                next();
            } else if (phase == 3 && custom(box.playlist$current()).equals(discA) && source() != null) {
                check(source() != previousSource, "ejecting a custom disc skips to the next source");
                Object current = source();
                finish.invoke(manager, world, POS, previousSource, "fixture-stale-completion");
                for (int i = 0; i < 25; i++) box.playlist$tick();
                check(source() == current && custom(box.playlist$current()).equals(discA), "stale completion cannot skip the replacement track");
                for (int i = 1; i < chest.getContainerSize(); i++) chest.setItem(i, ItemStack.EMPTY);
                previousSource = current;
                next();
            } else if (phase == 4 && source() != null && source() != previousSource) {
                check(custom(box.playlist$current()).equals(discA), "real audio completion repeats the custom disc with an empty chest");
                check(sourceCount() == 1, "repeat keeps one active source");
                chest.setItem(15, new ItemStack(Items.MUSIC_DISC_13));
                next();
            } else if (phase == 5 && box.playlist$current().getItem() == Items.MUSIC_DISC_13) {
                check(!LazoDiscsCompat.isCustom(box.playlist$current()), "mixed playlist transitions from custom audio to a vanilla disc");
                check(source() == null, "custom audio source is gone before vanilla playback");
                check(custom(chest.getItem(15)).equals(discA), "mixed exchange retains the recorded disc");
                chest.setItem(2, record(discB));
                eject();
                next();
            } else if (phase == 6 && custom(box.playlist$current()).equals(discB) && source() != null) {
                check(true, "vanilla eject transitions back into LazoDiscs audio");
                previousSource = source();
                chest.setItem(10, record(discA));
                world.setBlock(POS, Blocks.AIR.defaultBlockState(), 3);
                finish.invoke(manager, world, POS, previousSource, "fixture-after-removal");
                check(custom(chest.getItem(10)).equals(discA), "completion after block removal cannot consume a chest disc");
                check(source() == null, "removing the jukebox stops its Plasmo source");
                done = true;
                System.out.println("PLAYLIST LAZO TESTS PASSED: " + checks + " assertions");
                server.halt(false);
            }
            if (ticks - since > 1200) throw new AssertionError("Audio did not advance at phase " + phase);
        } catch (Throwable failure) {
            done = true;
            failure.printStackTrace();
            System.out.println("PLAYLIST LAZO TESTS FAILED: " + failure);
            server.halt(false);
        }
    }

    private static void next() { phase++; since = ticks; System.out.println("PLAYLIST LAZO PHASE: " + phase); }
    private static void check(boolean value, String message) { if (!value) throw new AssertionError(message); checks++; System.out.println("PLAYLIST LAZO CHECK: " + message); }
    private static ItemStack record(Object data) throws Exception { ItemStack stack = new ItemStack(Items.MUSIC_DISC_11); write.invoke(null, stack, data); return stack; }
    private static Object custom(ItemStack stack) throws Exception { if (stack.isEmpty()) return ""; Object data = ((Optional<?>) read.invoke(null, stack)).orElse(null); return data == null ? "" : data; }
    private static int sourceCount() throws Exception { return ((Map<?, ?>) active.get(manager)).size(); }
    private static Object source() throws Exception {
        for (Map.Entry<?, ?> entry : ((Map<?, ?>) active.get(manager)).entrySet()) {
            Object key = entry.getKey();
            if (POS.equals(key.getClass().getMethod("pos").invoke(key)) && world.dimension().equals(key.getClass().getMethod("dimension").invoke(key)))
                return entry.getValue().getClass().getMethod("source").invoke(entry.getValue());
        }
        return null;
    }
    private static void eject() { JukeboxBlockEntity entity = (JukeboxBlockEntity) box; @EJECT@ }
}
